{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moments-agent",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "COMMENTS_DB",
    "database_name": "moments-agent",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "./migrations"
  }],
  "queues": {
    "producers": [{ "binding": "SEMANTIC_QUEUE", "queue": "moments-writing" }],
    "consumers": [{
      "queue": "moments-writing",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_retries": 3,
      "retry_delay": 60,
      "dead_letter_queue": "moments-writing-dlq"
    }, {
      "queue": "moments-writing-dlq",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_retries": 0
    }]
  },
  "vars": {
    "MOMENTS_VISITOR_DAILY_LIMIT": "5",
    "MOMENTS_IP_DAILY_LIMIT": "20",
    "MOMENTS_DAILY_LIMIT": "100"
  }
}
